{
  "name": "generador-certificados-desktop",
  "version": "1.0.0",
  "description": "Generador de Certificados S/MIME - Aplicación de Escritorio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-portable": "npx electron-packager . \"Generador-Certificados-SMIME\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "clean": "rmdir /s /q dist 2>nul || echo Directorio limpio",
    "rebuild": "npm run clean && npm run build-portable"
  },

  "keywords": [
    "certificates", 
    "smime",
    "pki",
    "security",
    "electron"
  ],
  "author": {
    "name": "Equipo de Desarrollo",
    "url": "https://example.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-forge": "^1.3.1"
  }
}
