{
  "name": "generador-certificados-anticuantico",
  "version": "1.0.0",
  "description": "Generador de Certificados Post-Cuánticos - Resistente a Computación Cuántica",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build-portable": "npx electron-packager . \"Generador-Certificados-AntiCuantico\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "install-pqc": "npm install node-forge @peculiar/x509 @peculiar/asn1-schema @peculiar/webcrypto asn1js",
    "dev": "electron . --inspect"
  },
  "keywords": [
    "post-quantum",
    "crystals-dilithium",
    "x509",
    "s/mime",
    "pki",
    "quantum-resistant",
    "post-quantum",
    "certificates"
  ],
  "author": "Proyecto de Ejemplo",
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/post-quantum": "^0.5.2",
    "@peculiar/asn1-schema": "^2.3.8",
    "@peculiar/webcrypto": "^1.4.3",
    "@peculiar/x509": "^1.9.5",
    "@stablelib/x25519": "^2.0.1",
    "asn1js": "^3.0.5",
    "crypto-js": "^4.1.1",
    "electron": "^28.0.0",
    "electron-store": "^8.1.0",
    "elliptic": "^6.5.4",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "electron-packager": "^17.1.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://example.com"
  }
}
